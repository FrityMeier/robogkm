/* *************************************************************
 // Ultraschallsensor
 // der US-Sensor darf nicht so oft ausgelesen werden
 // Deswegen merkt sich die Software den Zeitpunkt der letzten Messung
 // wenn die neue Messung MILLISMINDIFF ms und kuerzer zurueckliegt,
 // so wird nicht erneut gemessen sondern der alte Wert zurueckgegeben.
 */
const int MILLISMINDIFF = 30;

int _pin[] = {  // der US-Sensor liegt auf dem Pin
  -1, -1, -1, -1, -1, -1};

unsigned long _lastMillis[] = {
  0ul, 0ul, 0ul, 0ul, 0ul, 0ul};

int _oldUsVal[] = {
  9999, 9999, 9999, 9999, 9999, 9999};


// jetzt di Funktion
int readUs(int pin){
  
  // schaue nach, ob der pin schon mal benutzt wurde
  int pin_number = -1;
  for(int n = 0; n < 6; n++){
    if( pin == _pin[n] ){
      pin_number = n;
      break;
    } 
  }

  // falls der pin noch  nicht benutzt wurde, so 
  // muss er in die Liste eingetragen werden
  if(pin_number == -1){
    // suche nach dem 1. freien Slot
    for(int n = 0; n < 6; n++){
      if(_pin[n] == -1){
        _pin[n] = pin;
        pin_number = n;
        break;
      }
    }
  }

  // wie lange ist die letzte Messung her?
  int millisAgo = millis() - _lastMillis[pin_number];

  // wurde erst vor kurzem gemessen, so soll einfach
  // der alte Wert zurueckgegeben werden
  if(millisAgo < MILLISMINDIFF){
    return _oldUsVal[pin_number];
  }

  // die letzte Messung liegt also schon ein bisschen zurueck
  // wir muessen neu messen
  long duration;
  int mm;

  // The PING))) is triggered by a HIGH pulse of 2 or more microseconds.
  // Give a short LOW pulse beforehand to ensure a clean HIGH pulse:
  pinMode(pin, OUTPUT);
  digitalWrite(pin, LOW);
  delayMicroseconds(2);
  digitalWrite(pin, HIGH);
  delayMicroseconds(15);
  digitalWrite(pin, LOW);
  delayMicroseconds(20);
  // The same pin is used to read the signal from the PING))): a HIGH
  // pulse whose duration is the time (in microseconds) from the sending
  // of the ping to the reception of its echo off of an object.
  pinMode(pin, INPUT);
  duration = pulseIn(pin, HIGH, 20000ul);
  mm = duration / 6; //microsecondsToCentimeters(duration);
  if(mm <= 0) mm = 9999;
  // merke dir den Wert ...
  _oldUsVal[pin_number] = mm;
  // ... und die Zeit, zu der gemessen wurde
  _lastMillis[pin_number] = millis();
  return mm;
}


boolean readButton(int pin){
  pinMode(pin, INPUT);
  digitalWrite(pin, HIGH);
  return digitalRead(pin); 
}


int readIr30(int analogPin){
  int result;
  int val = analogRead(analogPin);
  if (val < 3){
    result = 999; // invalid value
  }
  else{
    // v = 24570.0/analogRead(0)+6.0;
    float ret = (24570.0 /((float)val))+6.0;// - 3.0)) - 4.0;
    if(ret > 300){
      result = 999;
    }
    else if(ret < 30)
    {
      result = 0;
    }
    else
    {
      result = ret;
    }
  }
  //log(String(analogPin) + ";" + String(result) + "i");
  return result;
} 


int readLight(int analogPin){
  int result = analogRead(analogPin);
  //log(String(analogPin) + ";" + String(result) + "a");
  return result;
}

// ######################################
// Gruensensor

int _green_greenVals[] = {-1,-1,-1,-1,-1,-1,-1,-1};
int _green_redVals[] = {-1,-1,-1,-1,-1,-1,-1,-1};

//This function will write a 2 byte integer to the eeprom at the specified address and address + 1
void EEPROMWriteInt(int p_address, int p_value)
{
  byte lowByte = ((p_value >> 0) & 0xFF);
  byte highByte = ((p_value >> 8) & 0xFF);

  EEPROM.write(p_address, lowByte);
  EEPROM.write(p_address + 1, highByte);
}

//This function will read a 2 byte integer from the eeprom at the specified address and address + 1
int EEPROMReadInt(int p_address)
{
  byte lowByte = EEPROM.read(p_address);
  byte highByte = EEPROM.read(p_address + 1);

  return ((lowByte << 0) & 0xFF) + ((highByte << 8) & 0xFF00);
}


int readGreen(int analogPin, int digitalPin)
{
  // muessen die Werte noch gelesen werden?
  int slot = analogPin - 14;
  if(_green_greenVals[slot] == -1)
  {
    _green_redVals[slot] = EEPROMReadInt(slot*4);
    _green_greenVals[slot] = EEPROMReadInt(slot*4 + 2);
  }
  
  // put your main code here, to run repeatedly:
  pinMode(digitalPin, OUTPUT);
  digitalWrite(digitalPin, HIGH);
  delayMicroseconds(10);
  int _green = (int)((float)analogRead(analogPin) / (float)_green_redVals[slot] * 1000.0); //
  digitalWrite(digitalPin, LOW);
  delayMicroseconds(100);
  int _red = (int)((float)analogRead(analogPin) / (float)_green_greenVals[slot] * 1000.0); //
  pinMode(digitalPin, INPUT);
  return _green - _red;
}

int calibrateGreen(int analogPin, int digitalPin)
{
  print("Sensor am AnalogPort A");
  printLine(analogPin - 14);
  print("Steuerung der Farbe ueber digitalPin ");
  printLine(digitalPin);  
  printLine("Lass den Gruensensor auf die helle Flaeche leuchten");
  printLine("Gib einen beliebigen Buchstaben ein und druecke [Senden]");
  while (!Serial.available())
  {
    delay(100);
  }
  while (Serial.available())
  {
    Serial.read();
  }
  // Werte messen
  pinMode(digitalPin, OUTPUT);
  digitalWrite(digitalPin, HIGH);
  delay(1);
  int _red = (int)((float)analogRead(analogPin)*0.92);
  print("Rotwert=");
  print(_red);
  printLine(" ist gespeichert");
  delay(500);
  
  digitalWrite(digitalPin, LOW);
  delay(1);
  int _green = analogRead(analogPin);
  print("Gruenwert=");
  print(_green);
  printLine(" ist gespeichert");
  
  delay(500);
  pinMode(digitalPin, INPUT);  
  // werte speichern
  int slot = analogPin - 14;
  // der Wert sollte zwischen 0 und 7 sein
  EEPROMWriteInt(slot * 4, _red);
  EEPROMWriteInt(slot * 4 + 2, _green);

  while(1==1)
  {
    delay(100);
    printLine(readGreen(analogPin, digitalPin));
  }
}



void writePort(int port, int val){
  pinMode(port, OUTPUT);
  digitalWrite(port, val);
}

void writeHigh(int port){
  pinMode(port, OUTPUT);
  digitalWrite(port, HIGH);
}

void writeLow(int port){
  pinMode(port, OUTPUT);
  digitalWrite(port, LOW);
}

