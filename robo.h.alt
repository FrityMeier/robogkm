#include <Arduino.h>
#include <EEPROM.h>
#include <Adafruit_NeoPixel.h>

Adafruit_NeoPixel pixels;
boolean _neopixelStarted = false;

void writeLeds(int pin, int l1, int l2, int l3)
{
	if( _neopixelStarted == false )
	{
		pixels = Adafruit_NeoPixel(1, pin);
		pixels.begin();
		_neopixelStarted = true;
	}
	int red = 0;
	int blue = 0;
	int green = 0;
	if( (l1 & 1)>0 ){  red = 255; }else{ red = 0;}
	if( (l1 & 2)>0 ){green = 255; }else{ green = 0;}
	if( (l1 & 4)>0 ){ blue = 80; }else{ blue = 0;}
	if(l1 >= 0) pixels.setPixelColor(0, pixels.Color(red, green, blue));
	if( (l2 & 1)>0 ){  red = 80; }else{ red = 0;}
	if( (l2 & 2)>0 ){green = 80; }else{ green = 0;}
	if( (l2 & 4)>0 ){ blue = 80; }else{ blue = 0;}
	if(l2 >= 0) pixels.setPixelColor(1, pixels.Color(red, green, blue));
	if( (l3 & 1)>0 ){  red = 80; }else{ red = 0;}
	if( (l3 & 2)>0 ){green = 80; }else{ green = 0;}
	if( (l3 & 4)>0 ){ blue = 80; }else{ blue = 0;}
	if(l3 >= 0) pixels.setPixelColor(2, pixels.Color(red, green, blue));

	pixels.show(); // This sends the updated pixel color to the hardware.
}


/* ************************************************
// Serial
*/
boolean _serialIsConnected = false;

void _connectIfNeeded(){
  if( _serialIsConnected == false )
  {
    Serial.begin(57600);
    _serialIsConnected = true;
  }
}

void print(char c[]){
   _connectIfNeeded();
  Serial.write(c);
}

void print(int n){
  _connectIfNeeded();
  Serial.print(n);
}

void printLine(char c[]){
  _connectIfNeeded();
  Serial.println(c);
}

void printLine(String str){
  _connectIfNeeded();
  Serial.println(str);
}

void printLine(int n){
  _connectIfNeeded();
  Serial.println(n);
}

void printLine(){
  _connectIfNeeded();
  Serial.println();
}


/* ************************************************
 // Servo
 */
#include <Servo.h> 
Servo myservo[4];
int servoPin[]={
  -1,-1,-1,-1, -1, -1};



void writeServo(int pin, int pos){
  // welcher Servo haengt an dem Pin?
  for(int n=0; n<4; n++){
    if(servoPin[n] == pin){
      myservo[n].write(pos);
      return;
    }     
  }
  // er hat also keinen Servo gefunden
  // mal nach einem freien Slot suchen
  for(int n=0; n<4; n++){
    if(servoPin[n]<0){
      // freier Slot gefunden
      servoPin[n]=pin;
      myservo[n].attach(pin);
      myservo[n].write(pos);
      return;
    } 
  }
}


/* ////////////////////////////////////////////
 // Motoren
 */
//schaltet den Motor aus. Die Raeder "blockieren"
void Off(int m)  {
  // PINS als Ausgaenge setzen
  DDRD |= B11110000;
  DDRB |= B00000011;

  //Motor A
  if (m == 1  ||  m == 3) {
    digitalWrite(4, HIGH);
    digitalWrite(9, HIGH);
    analogWrite(5, 0);
  }

  //Motor B
  if (m==2 || m==3) {
    digitalWrite(7, HIGH);
    digitalWrite(8, HIGH);
    analogWrite(6, 0);
  }
}
 
void OnRev(int m, int v)
{
  // PINS als Ausgaenge setzen
  DDRD |= B11110000;
  DDRB |= B00000011;
 
  int dir = 1;
  if( v < 0){
	  dir = -1;
	  v = -v;
  }
  
  // den Wert auf "100" deckeln
  if(v > 100) {
    v = 100;
  }

  v = map(v, 0, 100, 0, 255);

  // Motor A
  if(dir == 1)
  {
	  if(m==1 || m==3){   // Motor A
		digitalWrite(4, HIGH);
		digitalWrite(9, LOW);    
		analogWrite(5, v);
	  }
	  if(m==2 || m==3){   // Motor B
		digitalWrite(7, HIGH);
		digitalWrite(8, LOW);    
		analogWrite(6, v);
	  }
  }
  else
  {
    if(m==1 || m==3){	// Motor A
      digitalWrite(4, LOW); //vrA1
      digitalWrite(9, HIGH);//vrA2    
      analogWrite(5, v); //enA
    }
    if(m==2 || m==3){	// Motor B
      digitalWrite(7, LOW);//vrB1
      digitalWrite(8, HIGH);//vrB2    
      analogWrite(6, v);
    }    
  }
    
}
 
void OnFwd(int m, int v){
  // bei negativen Werten "OnRev" aufrufen
  if(v < 0) {
    OnRev(m, -v);
    return;
  }

  // PINS als Ausgaenge setzen
  DDRD |= B11110000;
  DDRB |= B00000011;

  // den Wert auf "100" deckeln
  if(v > 100) {
    v = 100;
  }
  v = map(v, 0, 100, 0, 255);

  // Motor A
  if(m==1 || m==3){
    digitalWrite(4, LOW); //vrA1
    digitalWrite(9, HIGH);//vrA2    
    analogWrite(5, v); //enA
  }

  // Motor B
  if(m==2 || m==3){
    digitalWrite(7, LOW);//vrB1
    digitalWrite(8, HIGH);//vrB2    
    analogWrite(6, v);
  }    
}

 
 
void driveFwd() {
  OnFwd(3, 100);
}

void driveRev() {
  OnRev(3, 100);
}

void driveLeft(){
  OnFwd(1, 100);
  OnRev(2, 100);
}

void driveRight(){
  OnFwd(2, 100);
  OnRev(1, 100);
}

void driveOff(){
  Off(3);
}

void drive(int left, int right){
  if(left == 0){
    Off(2);
  }
  else{
    OnFwd(2, left);	
  }

  if(right == 0){
    Off(1);
  }
  else{
    OnFwd(1, right);
  }
}



